{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "jest"
    ],
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
