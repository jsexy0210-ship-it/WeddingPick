{
  "name": "@weddingpick/ui",
  "version": "0.0.0",
  "private": true,
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@weddingpick/domain": "*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.86",
    "react-native-safe-area-context": ">=5"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "^0.25.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "typescript": "~6.0.3"
  }
}
