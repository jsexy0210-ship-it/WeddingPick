# 필수
DATABASE_URL=postgres://weddingpick:비밀번호@localhost:5432/weddingpick

# 선택 — 기본값 3000
PORT=3000
# 선택 — 기본값 30일
SESSION_TTL_DAYS=30

# 원본 문서 저장소. 계약서 원본을 다루므로 국내 리전을 쓴다.
STORAGE_DRIVER=s3
S3_BUCKET=weddingpick-originals
S3_REGION=ap-northeast-2
# S3 호환 스토리지를 쓸 때만
# S3_ENDPOINT=https://kr.object.ncloudstorage.com

# 원본 보관 기간은 여기서 정하지 않는다.
#
# 검증이 끝난 날로부터 30일이고, 계산은 DB 뷰가 한다. 환경마다 다를 값이
# 아니라 정책이라 설정에서 뺐다 — 설정으로 둘 수 있으면 어느 환경은 그것을
# 끄고, 그 환경의 원본은 조용히 무기한 남는다.

# 예정일이 된 원본을 누가 지우는가.
#   manual    — 사람이 지운다. 서버는 운영자에게 알리기만 한다. (기본값)
#   automatic — 서버가 지운다.
# 기본값을 manual로 둔 것은, 설정을 빠뜨린 환경이 남의 계약서를 조용히
# 지우는 것보다 지우지 않고 알리는 쪽이 되돌릴 수 있는 실수이기 때문이다.
RETENTION_MODE=manual

# 파기할 문서가 처리되지 않은 채 이만큼 지나면 운영자에게 다시 알린다.
RETENTION_REMINDER_HOURS=24

# 분석 워커 (npm run worker)
ANTHROPIC_API_KEY=
# 선택 — 기본값 claude-opus-5
ANALYSIS_MODEL=claude-opus-5

# 브라우저에서 API를 부를 출처. 비워두면 CORS 헤더를 내보내지 않는다.
# 네이티브 앱에는 필요 없다.
CORS_ORIGINS=

# 개발용 로그인 (16자 이상). APPLE_CLIENT_ID가 없을 때만, NODE_ENV가 production이
# 아닐 때만 켜진다. 켜져 있으면 누구나 아무 계정이 될 수 있으므로 공개된 서버에 두지 말 것.
DEV_LOGIN_SECRET=

# 로그인 제공자. 설정한 것만 쓸 수 있다.
APPLE_CLIENT_ID=com.weddingpick.app
KAKAO_APP_KEY=

# 한 사람이 하루에 AI를 부를 수 있는 횟수. 비워두면 한도가 없다.
# 정해지기 전에는 숫자를 지어내지 않는다 — 0은 "한 번도 못 부르게 한다"는 다른 결정이다.
# AI_DAILY_CALL_LIMIT=
