# 웨딩픽 모바일 웹 export — 정적 호스팅 (하이브리드 웹뷰 쉘 POC)
#
# apps/mobile을 react-native-web으로 정적 빌드해 서빙한다. 하이브리드 웹뷰
# 쉘(`apps/mobile/src/features/webshell`)이 웹뷰로 로드하는 대상이다. 빌드
# 명령은 CI(`main.yml`)의 `Bundle (web)` 스텝과 같다.
FROM node:22-alpine AS build

WORKDIR /app

COPY . .

RUN npm ci
RUN npm run export:web --workspace @weddingpick/mobile

FROM node:22-alpine

WORKDIR /app

COPY --from=build /app/apps/mobile/dist ./dist

RUN npm install -g serve@14

EXPOSE 8080

# -s: 클라이언트 라우팅(expo-router)을 위해 없는 경로를 index.html로 되돌린다.
CMD ["serve", "-s", "dist", "-l", "8080"]
