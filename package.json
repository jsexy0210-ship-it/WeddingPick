{
  "name": "weddingpick",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @weddingpick/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run test:auth-hardening && npm run test:web-shell-auth && npm run test:root-entry",
    "test": "npm run test --workspaces --if-present",
    "build:ui": "npm run build --workspace @weddingpick/ui",
    "progress": "node scripts/progress.mjs",
    "test:auth-hardening": "node scripts/verify-auth-hardening.cjs",
    "test:web-shell-auth": "node scripts/verify-web-shell-auth.cjs",
    "test:root-entry": "node scripts/verify-root-entry.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@seed-design/css": "2.8.1",
    "@seed-design/icon": "0.6.2",
    "zod": "^4.4.3"
  }
}
