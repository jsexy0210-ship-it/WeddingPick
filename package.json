{
  "name": "weddingpick",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @weddingpick/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:ui": "npm run build --workspace @weddingpick/ui"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  }
}
